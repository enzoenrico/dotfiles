[user]
	email = e.enrico2005@gmail.com
	name = enzo
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[alias]
	adog = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
	dog = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
[difftool "vscode"]
	cmd = "code --wait --diff  "
[diff]
	tool = vscode
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = "code --wait "
[core]
	excludesfile = /Users/enzoenrico/.gitignore_global
[credential "https://huggingface.co"]
	provider = generic
[push]
	autoSetupRemote = true
