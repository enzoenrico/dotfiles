# Copy to ~/.secrets.zsh and fill in real values (never commit ~/.secrets.zsh)
#
#   cp ~/dotfiles/.secrets.zsh.example ~/.secrets.zsh

# Claude Code via OpenRouter
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="your-openrouter-api-key-here"
export ANTHROPIC_API_KEY=""
export ANTHROPIC_DEFAULT_SONNET_MODEL="qwen/qwen3-coder:free"
