<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kyou.borders-appearance-watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.config/borders/borders-appearance-watcher</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/com.kyou.borders-appearance-watcher.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/com.kyou.borders-appearance-watcher.err</string>
</dict>
</plist>
